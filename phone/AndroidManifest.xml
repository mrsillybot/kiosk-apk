<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dk.mrsilly.phone">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Mr Silly"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="dk.mrsilly.kiosk.PhoneActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="dk.mrsilly.kiosk.PhoneSettingsActivity"
            android:exported="false"
            android:label="Indstillinger" />
        <receiver android:name="dk.mrsilly.kiosk.UpdateReceiver" android:exported="false" />
    </application>
</manifest>
